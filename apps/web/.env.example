# Local: values printed by `supabase start`. No remote project yet.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used for ledger writes and role elevation.
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Paystack). Test keys start sk_test_ / pk_test_. Server only; the webhook URL to register in the
# Paystack dashboard is {NEXT_PUBLIC_SITE_URL}/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Public URL of the web app (used for Paystack's return link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identity checks (Smile ID). Sandbox by default; set SMILE_ID_ENV=production for live. Server only.
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENV=sandbox
